# ExamForge AI — Environment Configuration Template
# Copy this file to .env and configure values for your environment

# Flask Application & Security Secrets
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_SECRET_KEY=change-this-jwt-secret-in-production

# Database Configuration (Defaults to local SQLite database)
DATABASE_URL=sqlite:///database/examforge.db

# CORS Allowed Origins (comma-separated list; strictly http://localhost:5173 in local dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server Port
PORT=5000
